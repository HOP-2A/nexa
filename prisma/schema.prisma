generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id             String           @id @default(nanoid())
  firstname      String
  lastname       String
  clerkId        String           @unique
  email          String           @unique
  createdAt      DateTime         @default(now())
  profilePic     String?
  phone          String?
  presiding      Club[]           @relation("ClubPresident")
  applications   ClubForm[]
  clubToStudents ClubToStudents[]
  mentorStudent  MentorStudent[]
  clubs          Club[]           @relation("ClubToStudent")
  MentorAvailability  MentorAvailability[]
}

model Club {
  id             String           @id @default(nanoid())
  name           String
  createdAt      DateTime         @default(now())
  description    String
  code           String
  presidentId    String?
  president      Student?         @relation("ClubPresident", fields: [presidentId], references: [id])
  events         ClubEvent[]      @relation("ClubEvents")
  applications   ClubForm[]
  clubToStudents ClubToStudents[]
  students       Student[]        @relation("ClubToStudent")
}

model Mentor {
  id              String          @id @default(nanoid())
  firstname       String
  lastname        String
  email           String          @unique
  clerkId         String          @unique
  rating          Ratings         @default(NONE)
  bio             String?
  description     String?
  profilePic      String?
  experienceYears String?
  courses         Course[]
  mentorStudent   MentorStudent[]
  MentorAvailability  MentorAvailability[]

}

model ClubEvent {
  eventId      String      @id @default(nanoid())
  clubId       String
  title        String
  description  String
  startingAt   DateTime
  endingAt     DateTime?
  createdAt    DateTime    @default(now())
  location     String?
  onlineLink   String?
  capacity     Int?
  status       EventStatus
  participants String[]
  club         Club        @relation("ClubEvents", fields: [clubId], references: [id])
}

model MentorStudent {
  id        String           @id @default(nanoid())
  studentId String
  mentorId  String
  createdAt DateTime         @default(now())
  status    MentorshipStatus
  Mentor    Mentor           @relation(fields: [mentorId], references: [id])
  Student   Student          @relation(fields: [studentId], references: [id])
}

model ClubForm {
  id                String            @id @default(nanoid())
  clubId            String
  studentId         String
  status            ApplicationStatus @default(PENDING)
  message           String?
  submittedAt       DateTime          @default(now())
  age               Int?
  class             String?
  personalStatement String?
  experience        String?
  skills            String?
  whyThisClub       String?
  club              Club              @relation(fields: [clubId], references: [id])
  student           Student           @relation(fields: [studentId], references: [id])
}

model ClubToStudents {
  id        String  @id @default(nanoid())
  studentId String
  clubId    String
  Club      Club    @relation(fields: [clubId], references: [id])
  Student   Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, clubId])
}

model Course {
  id           String   @id @default(nanoid())
  mentorId     String
  createdAt    DateTime @default(now())
  paymentValue String
  courseTitle  String
  courseInfo   String
  mentor       Mentor   @relation(fields: [mentorId], references: [id])
   MentorAvailability  MentorAvailability[]

}
model MentorAvailability {
  id          String      @id @default(cuid())
  startTime   String
  endTime     String
  status      SlotStatus  @default(AVAILABLE)
  availableDate      DateTime
  mentorId    String
  mentor      Mentor      @relation(fields: [mentorId], references: [id])
courseId    String
  course      Course      @relation(fields: [courseId], references: [id])

  studentId   String?
  student     Student?    @relation(fields: [studentId], references: [id])

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Invites {
  id           String  @id @default(nanoid())
  studentEmail String
  code         String
  inviterId    String
  Student      Student @relation(fields: [inviterId], references: [id])
}

model Post {
  id        String     @id @default(nanoid())
  title     String
  content   String
  studentId String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  status    PostStatus @default(MEMBER)

  Student Student   @relation(fields: [studentId], references: [id])
  comment Comment[]
}

model Comment {
  id        String  @id @default(nanoid())
  content   String
  studentId String
  Student   Student @relation(fields: [studentId], references: [id])
  postId    String
  Post      Post    @relation(fields: [postId], references: [id])
}

model MentorAvailability {
  id            String     @id @default(cuid())
  startTime     String
  endTime       String
  status        SlotStatus @default(AVAILABLE)
  availableDate DateTime
  mentorId      String
  mentor        Mentor     @relation(fields: [mentorId], references: [id])
  courseId      String
  course        Course     @relation(fields: [courseId], references: [id])

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Ratings {
  FIVE
  FOUR
  THREE
  TWO
  ONE
  NONE
}

enum EventStatus {
  NEW
  PASSED
  CANCELLED
}

enum MentorshipStatus {
  ACTIVE
  PAUSED
  PENDING
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SlotStatus {
  AVAILABLE 
  BOOKED  
  PENDING   
  CANCELED   
}
